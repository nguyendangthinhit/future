# Copy this file to .env and fill in real values.
# Mọi key đều OPTIONAL: thiếu key nào thì service đó chạy MOCK MODE (không crash).
# Chỉ cần điền khi muốn ra dữ liệu THẬT.

# --- Tạo kịch bản (Agent 1 & 2) + caption. Thiếu -> agent trả JSON mock ---
GEMINI_API_KEY=

# --- Render video. Thiếu -> trả video mẫu mov_bbb.mp4 ---
ECOMDY_API_KEY=

# --- Tìm kiếm Google (optional, chỉ dùng khi use_google_data=true) ---
SERPER_API_KEY=

# --- Database & Storage (Google Workspace) ---
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
GOOGLE_SHEET_ID=1Gtb4iKtGZqupxGSLdXbSC9M2GSMqj67v9AMd2Byk2wM
GOOGLE_DRIVE_FOLDER_ID=1hluG_R2HcHPTFknCjnXGdDcmHAugN6be

# --- n8n webhook để lên lịch đăng bài. Thiếu/để default -> bỏ qua bước n8n ---
N8N_WEBHOOK_URL=http://your-n8n.com/webhook/create-video

# --- URL backend tự gọi lại (callback từ n8n). Mặc định localhost ---
BACKEND_URL=http://localhost:8000
