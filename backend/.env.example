# Copy this file to .env and fill in real values.
# Mọi key đều OPTIONAL: thiếu key nào thì service đó chạy MOCK MODE (không crash).
# Chỉ cần điền khi muốn ra dữ liệu THẬT.

# --- Backend switch (model_gateway) ---
# 'legacy'  : Gemini (LLM) + Ecomdy (video) — dùng code hiện tại
# 'byteplus': Seed 2.0 / ModelArk (LLM) + Seedance 2.0 (video) — khi có key
MODEL_BACKEND=legacy

# --- Tạo kịch bản (Agent 1 & 2) + caption. Thiếu -> agent trả JSON mock ---
# (legacy backend) dùng Gemini
GEMINI_API_KEY=

# --- Render video. Thiếu -> trả video mẫu mov_bbb.mp4 ---
# (legacy backend) dùng Ecomdy
ECOMDY_API_KEY=

# --- Voiceover (optional) ---
# Nếu có ELEVENLABS_API_KEY, factory sẽ ưu tiên ElevenLabs cho voiceover.
# Voice ID lấy trong dashboard ElevenLabs. Nếu để trống, code dùng default voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_STABILITY=0.45
ELEVENLABS_SIMILARITY_BOOST=0.75

# --- BytePlus backend (Seed 2.0 + Seedance 2.0) ---
# Chỉ dùng khi MODEL_BACKEND=byteplus. Để trống thì app fallback về legacy.
BYTEPLUS_SEED2_API_KEY=
BYTEPLUS_SEED2_MODEL=seed-2-0-pro
BYTEPLUS_SEEDANCE_API_KEY=

# --- Tìm kiếm Google (optional, chỉ dùng khi use_google_data=true) ---
SERPER_API_KEY=

# --- Database & Storage (Google Workspace) ---
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
GOOGLE_SHEET_ID=1Gtb4iKtGZqupxGSLdXbSC9M2GSMqj67v9AMd2Byk2wM
GOOGLE_DRIVE_FOLDER_ID=1hluG_R2HcHPTFknCjnXGdDcmHAugN6be

# --- n8n webhook để lên lịch đăng bài. Thiếu/để default -> bỏ qua bước n8n ---
N8N_WEBHOOK_URL=http://your-n8n.com/webhook/create-video

# --- URL backend tự gọi lại (callback từ n8n). Mặc định localhost ---
BACKEND_URL=http://localhost:8000
